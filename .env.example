# Provide either a Google Gemini API Key or an OpenAI API Key:
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# or
# GEMINI_API_KEY=your_gemini_api_key_here
# or
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Tavily API Key for real-time web search (https://tavily.com)
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional model routing configuration:
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# AI_MODEL=gemini-flash-lite-latest

# Chat persistence (optional) -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
